# Copy to .env (git-ignored). Never commit real values; in deploy these live in the host's secret manager.

# --- Backend (backend/app/config.py) ---
NANFENG_DATABASE_URL=sqlite:///./nanfeng.db
NANFENG_QUANT_URL=http://localhost:8100
# Shared by the backend and the agent. Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = agent routes refuse every caller; the placeholder change-me is refused at startup (threat model F6).
NANFENG_AGENT_TOKEN=
# NANFENG_ALLOW_OPEN_AGENT=true  # local development only: no token, any caller is the agent
NANFENG_SANDBOX_OTP=482913
# Owner sign-in (threat model F1). The demo password is public: a real deploy sets its own and
# NANFENG_DEMO=false (which also removes POST /bank/reset). Empty secret = sessions die on restart.
NANFENG_OWNER_PASSWORD=huerto-demo-2026
NANFENG_SESSION_SECRET=
NANFENG_DEMO=true
# Demo builds: put the shared sandbox back at the start of the Cherry Crisis after this many seconds
# with no new audit entry (never mid-take). 0 = never.
NANFENG_SANDBOX_IDLE_RESET_S=1800
NANFENG_OTP_MODE=sandbox        # sms = random code per approval, texted by Zavu to the owner (r4-05)
NANFENG_OTP_SECRET=             # HMAC key for stored OTP hashes; set a long random value in deploy
NANFENG_OWNER_PHONE=            # E.164, e.g. +56911112222
NANFENG_ANCHOR_BACKEND=local   # evm = anchor on the testnet below
NANFENG_CORS_ORIGINS=["http://localhost:3000","http://localhost:3100"]
POSTGRES_PASSWORD=nanfeng-local

# --- Provider keys (Renato). Set a spend limit on each account. ---
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
ZAVU_API_KEY=
ELEVENLABS_API_KEY=

# --- Agent (renato-lenis/, r2-09). Service on :8200: uvicorn nanfeng_agent.service:app --port 8200 ---
NANFENG_BACKEND_URL=http://localhost:8000
NANFENG_OWNER_LANGUAGE=es       # es | en | zh: alerts, approvals and the briefing for the owner
NANFENG_ZAVU_WEBHOOK_SECRET=    # shared with Zavu's webhook (X-Webhook-Token header) for POST /inbound/zavu
ELEVENLABS_VOICE_ID=            # optional: the briefing voice
# NANFENG_MODEL_PLAN=anthropic/claude-sonnet-4.5,openai/gpt-4.1   # optional: OpenRouter models, fallback order

# --- Chain (r3-05): EVM testnet anchoring. Testnet-only wallet, never one with real funds. ---
NANFENG_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NANFENG_EVM_PRIVATE_KEY=
NANFENG_EVM_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx

# --- Invoice registry against double financing (r3-06). Same RPC and wallet as anchoring. ---
NANFENG_REGISTRY_BACKEND=local          # evm = InvoiceRegistry contract (deploy: cd backend && python chain/deploy.py)
NANFENG_INVOICE_REGISTRY_ADDRESS=       # printed by chain/deploy.py
NANFENG_REGISTRY_WAIT_RECEIPT_S=0       # >0: wait for the registration to be mined before paying out
