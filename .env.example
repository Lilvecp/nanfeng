# Copy to .env (git-ignored). Never commit real values; in deploy these live in the host's secret manager.

# --- Backend (backend/app/config.py) ---
NANFENG_DATABASE_URL=sqlite:///./nanfeng.db
NANFENG_QUANT_URL=http://localhost:8100
NANFENG_AGENT_TOKEN=change-me
NANFENG_SANDBOX_OTP=482913
# Owner sign-in (threat model F1). The demo password is public: a real deploy sets its own and
# NANFENG_DEMO=false (which also removes POST /bank/reset). Empty secret = sessions die on restart.
NANFENG_OWNER_PASSWORD=huerto-demo-2026
NANFENG_SESSION_SECRET=
NANFENG_DEMO=true
NANFENG_OTP_MODE=sandbox        # sms = random code per approval, texted by Zavu to the owner (r4-05)
NANFENG_OTP_SECRET=             # HMAC key for stored OTP hashes; set a long random value in deploy
NANFENG_OWNER_PHONE=            # E.164, e.g. +56911112222
NANFENG_ANCHOR_BACKEND=local   # evm = anchor on the testnet below
NANFENG_CORS_ORIGINS=["http://localhost:3000","http://localhost:3100"]
POSTGRES_PASSWORD=nanfeng-local

# --- Provider keys (Renato). Set a spend limit on each account. ---
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
ZAVU_API_KEY=
ELEVENLABS_API_KEY=

# --- Chain (r3-05): EVM testnet anchoring. Testnet-only wallet, never one with real funds. ---
NANFENG_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NANFENG_EVM_PRIVATE_KEY=
NANFENG_EVM_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx
