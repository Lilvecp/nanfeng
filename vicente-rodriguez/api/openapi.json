        "$ref": "#/components/schemas/PassportRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PassportResponse"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/quant/demo/{artifact}": {
   "get": {
    "summary": "Demo",
    "description": "Precomputed Cherry Crisis results for Demo Mode: no computation, no network dependency.",
    "operationId": "demo_quant_demo__artifact__get",
    "parameters": [
     {
      "name": "artifact",
      "in": "path",
      "required": true,
      "schema": {
       "enum": [
        "before",
        "forecast",
        "quotes",
        "plan",
        "passport",
        "scenario_lab",
        "story"
       ],
       "type": "string",
       "title": "Artifact"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "title": "Response Demo Quant Demo  Artifact  Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/quant/sandbox/seed": {
   "get": {
    "summary": "Sandbox Seed",
    "description": "Accounts, receivables, lenders and FX for the sandbox bank, from the same scenario and catalog\nthe engine uses (so plan operations reference lenders and invoices that exist in the bank).",
    "operationId": "sandbox_seed_quant_sandbox_seed_get",
    "parameters": [
     {
      "name": "scenario",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "cherry_crisis",
       "title": "Scenario"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": true,
         "title": "Response Sandbox Seed Quant Sandbox Seed Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/quant/tools": {
   "get": {
    "summary": "Agent Tools",
    "description": "Function-calling schemas (OpenAI / OpenRouter format) of the agent tools.",
    "operationId": "agent_tools_quant_tools_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "additionalProperties": true,
          "type": "object"
         },
         "type": "array",
         "title": "Response Agent Tools Quant Tools Get"
        }
       }
      }
     }
    }
   }
  },
  "/quant/schema/scenario": {
   "get": {
    "summary": "Scenario Schema",
    "description": "JSON Schema of a scenario object (company, customers, receivables, shipments, payables).",
    "operationId": "scenario_schema_quant_schema_scenario_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "type": "object",
         "title": "Response Scenario Schema Quant Schema Scenario Get"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "ApprovalRequest": {
    "properties": {
     "action": {
      "type": "string",
      "title": "Action"
     },
     "operations": {
      "items": {
       "$ref": "#/components/schemas/Operation"
      },
      "type": "array",
      "title": "Operations"
     },
     "explanation": {
      "type": "string",
      "title": "Explanation"
     },
     "channel": {
      "type": "string",
      "title": "Channel"
     },
     "unsupported": {
      "items": {
       "$ref": "#/components/schemas/Operation"
      },
      "type": "array",
      "title": "Unsupported",
      "default": []
     }
    },
    "additionalProperties": true,
    "type": "object",
    "required": [
     "action",
     "operations",
     "explanation",
     "channel"
    ],
    "title": "ApprovalRequest",
    "description": "Body for the backend's POST /approvals (extra keys are ignored there)."
   },
   "CreditGrade": {
    "properties": {
     "score": {
      "type": "number",
      "title": "Score"
     },
     "grade": {
      "type": "string",
      "enum": [
       "A",
       "B",
       "C",
       "D",
       "E"
      ],
      "title": "Grade"
     }
    },
    "additionalProperties": true,
    "type": "object",
    "required": [
     "score",
     "grade"
    ],
    "title": "CreditGrade"
   },
   "Driver": {
    "properties": {
     "driver": {
      "type": "string",
      "enum": [
       "customer",
       "announced_delay",
       "fx",
       "price"
      ],
      "title": "Driver"
     },
     "id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Id"
     },
     "counterfactual": {
      "type": "string",
      "title": "Counterfactual"
     },
     "prob_negative_by_day": {
      "type": "number",
      "title": "Prob Negative By Day"
     },
     "delta_vs_base": {
      "type": "number",
      "title": "Delta Vs Base"
     }
    },
    "additionalProperties": true,
    "type": "object",
    "required": [
     "driver",
     "id",
     "counterfactual",
     "prob_negative_by_day",
     "delta_vs_base"
    ],
    "title": "Driver"
   },
   "Drivers": {
    "properties": {
     "probe_date": {
      "type": "string",
      "title": "Probe Date"
     },
     "drivers": {
      "items": {
       "$ref": "#/components/schemas/Driver"
      },
      "type": "array",
      "title": "Drivers"
     },
     "explanation": {
      "type": "string",
      "title": "Explanation"
     }
    },
    "additionalProperties": true,
    "type": "object",
    "required": [
     "probe_date",
     "drivers",
     "explanation"
    ],
    "title": "Drivers"
   },
   "Explanation": {
    "properties": {
     "product_id": {
      "type": "string",
      "title": "Product Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "selected": {
      "type": "boolean",
      "title": "Selected"
     },
     "reason": {
      "type": "string",
      "title": "Reason"
     }
    },
    "additionalProperties": true,
    "type": "object",
    "required": [
     "product_id",
     "name",
     "selected",
     "reason"
    ],
    "title": "Explanation"
   },
   "FanChart": {
    "properties": {
     "dates": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Dates"
     },
     "p10": {
      "items": {
       "type": "number"
      },
      "type": "array",
      "title": "P10"
     },
     "p50": {
      "items": {
       "type": "number"
      },
      "type": "array",
      "title": "P50"
     },
     "p90": {
      "items": {
       "type": "number"
      },
      "type": "array",
      "title": "P90"
     },
     "p_negative": {
      "items": {
       "type": "number"
      },
      "type": "array",
      "title": "P Negative"
     },
     "buffer": {
      "type": "number",
      "title": "Buffer"
     }
    },
    "additionalProperties": true,
    "type": "object",
    "required": [
     "dates",
     "p10",
     "p50",
     "p90",
     "p_negative",
     "buffer"
    ],
    "title": "FanChart"
   },
   "ForecastRequest": {
    "properties": {
     "scenario": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "additionalProperties": true,
        "type": "object"
       }
      ],
      "title": "Scenario",
      "description": "Scenario id in data/scenarios, or a full scenario object (see ScenarioSchema)",
      "default": "cherry_crisis"
     },
     "overrides": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Overrides"
       },
       {
        "type": "null"
       }
      ]
     },
     "n_paths": {
      "type": "integer",
      "maximum": 100000.0,
      "minimum": 100.0,
      "title": "N Paths",
      "default": 10000
     },
     "seed": {
      "type": "integer",
      "title": "Seed",
      "default": 7
     },
     "explain": {
      "type": "boolean",
      "title": "Explain",
      "default": true
     }
    },
    "type": "object",
    "title": "ForecastRequest"
   },
   "ForecastResponse": {
    "properties": {
     "summary": {
      "$ref": "#/components/schemas/Summary"
     },
     "fan_chart": {
      "$ref": "#/components/schemas/FanChart"
     },
     "drivers": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Drivers"
       },
       {
        "type": "null"
       }
      ]
     },
     "latency_ms": {
      "type": "integer",
      "title": "Latency Ms"
     },
     "source": {
      "$ref": "#/components/schemas/Source"
     }
    },
    "additionalProperties": true,
    "type": "object",
    "required": [
     "summary",
     "fan_chart",
     "latency_ms",
     "source"
    ],
    "title": "ForecastResponse"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Operation": {
    "properties": {
     "op": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Op"
     },
     "params": {
      "additionalProperties": true,
      "type": "object",
      "title": "Params"
     }
    },
    "additionalProperties": true,
    "type": "object",
    "required": [
     "op",
     "params"
    ],
    "title": "Operation"
   },
   "Overrides": {
    "properties": {
     "customer_delay_extra_days": {
      "additionalProperties": {
       "type": "number"
      },
      "type": "object",
      "title": "Customer Delay Extra Days",
      "description": "Extra delay per customer id, days"
     },
     "global_delay_extra_days": {
      "type": "number",
      "title": "Global Delay Extra Days",
      "description": "Extra delay for every customer, days",
      "default": 0.0
     },
     "cny_shift_pct": {
      "type": "number",
      "title": "Cny Shift Pct",
      "description": "Level shift of CLP per CNY from today, %",
      "default": 0.0
     },
     "usd_shift_pct": {
      "type": "number",
      "title": "Usd Shift Pct",
      "description": "Level shift of CLP per USD from today, %",
      "default": 0.0
     },
     "cherry_price_pct": {
      "type": "number",
      "title": "Cherry Price Pct",
      "description": "Change in cherry price for uninvoiced shipments, %",
      "default": 0.0
     },
     "extra_hires": {
      "type": "integer",
      "minimum": 0.0,
      "title": "Extra Hires",
      "description": "Extra workers added to every payroll",
      "default": 0
     },
     "hire_monthly_wage_clp": {
      "type": "number",
      "title": "Hire Monthly Wage Clp",
      "default": 750000.0
     },
     "on_time_customers": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "On Time Customers"
     },
     "defaulted_customers": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Defaulted Customers"
     },
     "ignore_announced_delays": {
      "type": "boolean",
      "title": "Ignore Announced Delays",
      "default": false
     },
     "freeze_fx": {
      "type": "boolean",
      "title": "Freeze Fx",
      "default": false
     },
     "freeze_price": {
      "type": "boolean",
      "title": "Freeze Price",
      "default": false
     }
    },
    "additionalProperties": false,
    "type": "object",
    "title": "Overrides",
    "description": "Scenario Lab knobs and counterfactual switches. All optional."
   },
   "PassportChange": {
    "properties": {
     "before": {
      "$ref": "#/components/schemas/CreditGrade"
