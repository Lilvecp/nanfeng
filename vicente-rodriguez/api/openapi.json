      "type": "string",
      "title": "Factor"
     },
     "description": {
      "type": "string",
      "title": "Description"
     },
     "value": {
      "type": "number",
      "title": "Value"
     },
     "sub_score": {
      "type": "number",
      "title": "Sub Score"
     },
     "weight": {
      "type": "number",
      "title": "Weight"
     },
     "points": {
      "type": "number",
      "title": "Points"
     }
    },
    "additionalProperties": true,
